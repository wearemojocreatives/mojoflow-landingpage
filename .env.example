# MOJO FLOW Waitlist Environment Variables

# Email Notification Recipient
NOTIFICATION_EMAIL=no-reply@mojoflow.in

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@mojoflow.in
SMTP_PASS=your-smtp-password-or-app-key
SMTP_FROM="MOJO FLOW" <no-reply@mojoflow.in>

# Supabase Credentials (waitlist_leads table)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
